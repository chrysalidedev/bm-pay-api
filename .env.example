# =============================================================================
# MODÈLE DE CONFIGURATION BUILD-MAIN BACKEND (.env.example)
# Copier vers .env.local, .env.dev ou .env.prod selon votre environnement
# =============================================================================

# Environnement applicatif ("local", "dev" ou "prod")
APP_ENV=local

# Port HTTP du serveur Ktor
PORT=8080

# URL de base publique du serveur
APP_BASE_URL=http://localhost:8080

# Origines autorisées pour le partage de ressources cross-origin (séparées par virgule)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Configuration Base de données :
# En local : jdbc:sqlite:build_main.db (Driver: org.sqlite.JDBC)
# En dev/prod : jdbc:postgresql://host:5432/dbname (Driver: org.postgresql.Driver)
DB_JDBC_URL=jdbc:sqlite:build_main.db
DB_DRIVER=org.sqlite.JDBC
DB_USER=
DB_PASSWORD=

# Passerelle Partenaire Jèko (Encaissement Mobile Money & Cartes)
JEKO_API_BASE_URL=https://api.jeko.africa
JEKO_DEFAULT_STORE_ID=votre_store_id_uuid
JEKO_DEFAULT_API_KEY=jeko_votre_cle_api
JEKO_DEFAULT_API_KEY_ID=votre_key_id_uuid
JEKO_DEFAULT_WEBHOOK_SECRET=votre_webhook_secret_hmac
